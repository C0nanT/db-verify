#!/usr/bin/env bash
# Ponto de entrada único dos gates de qualidade. Ver .scratch/quality-gates/SPEC.md.
#
# Uso: scripts/check <nível>
#   fast — formatação, go vet, lint, secrets scan (gitleaks) e testes unitários (sem Docker)
#
# Ferramentas do gate são tool dependencies do go.mod (diretiva `tool`, invocadas via
# `go tool <nome>`), pinadas junto com as demais dependências. Comando único que
# instala/prepara todas: `go mod download`.
#
# Funciona a partir de qualquer subdiretório do repo.

set -uo pipefail

VALID_LEVELS=(fast)

usage_error() {
  echo "Erro: nível ausente ou inválido." >&2
  echo "Uso: scripts/check <nível>" >&2
  echo "Níveis válidos: ${VALID_LEVELS[*]}" >&2
  exit 1
}

level="${1:-}"
if [[ -z "$level" ]]; then
  usage_error
fi

level_valid=false
for candidate in "${VALID_LEVELS[@]}"; do
  if [[ "$candidate" == "$level" ]]; then
    level_valid=true
    break
  fi
done
if [[ "$level_valid" != true ]]; then
  usage_error
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Erro: scripts/check precisa ser executado dentro de um repositório git." >&2
  exit 1
}
cd "$repo_root" || exit 1

check_format() {
  local unformatted
  unformatted="$(gofmt -l .)"
  if [[ -n "$unformatted" ]]; then
    echo "Formatação falhou. Arquivos divergentes de gofmt:" >&2
    echo "$unformatted" >&2
    echo "Corrija com: gofmt -w <arquivo>" >&2
    return 1
  fi
  return 0
}

check_vet() {
  go vet ./...
}

GOLANGCI_LINT_PKG="github.com/golangci/golangci-lint/cmd/golangci-lint"
GOLANGCI_LINT_MOD="github.com/golangci/golangci-lint"

check_lint() {
  if ! go tool golangci-lint version >/dev/null 2>&1; then
    local version
    version="$(go list -m -f '{{.Version}}' "$GOLANGCI_LINT_MOD" 2>/dev/null)"
    echo "Ferramenta ausente: golangci-lint." >&2
    echo "Instale/prepare as ferramentas do gate com: go mod download" >&2
    if [[ -n "$version" ]]; then
      echo "Se o problema persistir: go get -tool ${GOLANGCI_LINT_PKG}@${version}" >&2
    fi
    return 1
  fi
  go tool golangci-lint run ./...
}

GITLEAKS_MOD="github.com/zricethezav/gitleaks/v8"

# Escaneia o conteúdo staged (o que vai para o commit). Allowlist em .gitleaks.toml.
check_secrets() {
  if [[ ! -f .gitleaks.toml ]]; then
    echo "Configuração ausente: .gitleaks.toml (allowlist versionada do secrets scan)." >&2
    return 1
  fi
  if ! go tool gitleaks version >/dev/null 2>&1; then
    local version
    version="$(go list -m -f '{{.Version}}' "$GITLEAKS_MOD" 2>/dev/null)"
    echo "Ferramenta ausente: gitleaks." >&2
    echo "Instale/prepare as ferramentas do gate com: go mod download" >&2
    if [[ -n "$version" ]]; then
      echo "Se o problema persistir: go get -tool ${GITLEAKS_MOD}@${version}" >&2
    fi
    return 1
  fi
  go tool gitleaks git --staged --no-banner -c .gitleaks.toml
}

check_unit() {
  go test ./...
}

failed_stage=""

run_fast() {
  echo "==> [fast] formatação (gofmt)"
  if ! check_format; then
    failed_stage="format"
    return 1
  fi

  echo "==> [fast] análise estática (go vet)"
  if ! check_vet; then
    failed_stage="vet"
    return 1
  fi

  echo "==> [fast] lint estático (golangci-lint)"
  if ! check_lint; then
    failed_stage="lint"
    return 1
  fi

  echo "==> [fast] secrets scan (gitleaks)"
  if ! check_secrets; then
    failed_stage="secrets"
    return 1
  fi

  echo "==> [fast] testes unitários (go test)"
  if ! check_unit; then
    failed_stage="unit"
    return 1
  fi

  return 0
}

case "$level" in
  fast)
    run_fast
    ;;
esac
exit_code=$?

if [[ $exit_code -eq 0 ]]; then
  echo "Gate '$level' passou."
else
  echo "Gate '$level' falhou na etapa: $failed_stage"
fi

exit $exit_code
